#!/usr/bin/env bash

set -eu
[ "${BASH_VERSINFO[0]}" -ge 3 ] && set -o pipefail

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/cmake.bash
source "$plugin_dir/lib/cmake.bash"
# shellcheck source=lib/eerie.bash
source "$plugin_dir/lib/eerie.bash"

tmp_download_dir=$(mktemp -dt io_build_XXXXXX)
source_path="$tmp_download_dir/io-${ASDF_INSTALL_TYPE}-${ASDF_INSTALL_VERSION}"

git clone --recursive --branch "$ASDF_INSTALL_VERSION" --depth 1 https://github.com/IoLanguage/io "$source_path"

(
    cd "$source_path"

    # Only for versions before 2019.05.22-alpha, since after this version addons were
    # separated from the main repo and are now installed with eerie
    if [[ -z "${WITH_IO_ADDONS:-}" ]]; then
        sed -i.bak "s|add_subdirectory(addons)|#add_subdirectory(addons)|" CMakeLists.txt
    fi

    # 2015.11.11 and earlier misspell the garbage collector target as
    # `garabagecollector` in the libs/CMakeLists.txt add_dependencies() call.
    # Old cmake silently ignored the unknown dependency; CMake 4 fails the
    # generate step ("target ... does not exist"). Fix the typo so those
    # versions build. No-op on versions that already spell it correctly.
    if [[ -f libs/CMakeLists.txt ]]; then
        sed -i.bak "s|garabagecollector|garbagecollector|g" libs/CMakeLists.txt
    fi

    # glibc 2.32 removed <sys/sysctl.h>, so the bare include in
    # libs/iovm/source/IoSystem.c fails to compile on modern Linux. Every
    # sysctl() call in the tree is guarded by CTL_HW/HW_* macros that this
    # same header defines, with a sysconf() fallback, so swapping the include
    # for one that always exists is safe. macOS still ships the header, so
    # the patch is Linux-only.
    if [[ "$(io_os)" == "Linux" ]]; then
        { grep -rl 'include <sys/sysctl.h>' libs 2>/dev/null || true; } |
            while IFS= read -r file; do
                sed -i.bak 's|include <sys/sysctl\.h>|include <unistd.h> /* sys/sysctl.h removed in glibc 2.32 */|' "$file"
            done
    fi

    # Read the flags into an array line by line (bash 3.2 has no mapfile).
    CMAKE_FLAGS=()
    while IFS= read -r flag; do
        CMAKE_FLAGS+=("$flag")
    done < <(io_cmake_flags "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH" "$(io_host_arch)")

    cmake "${CMAKE_FLAGS[@]}"
    make install
)

# Install the eerie package manager by default for versions that ship it.
# Opt out with WITHOUT_EERIE=1. Best-effort: never fails the Io install.
if [[ -z "${WITHOUT_EERIE:-}" ]] && io_eerie_supported "$ASDF_INSTALL_VERSION"; then
    io_install_eerie "$source_path" "$ASDF_INSTALL_PATH"
fi
