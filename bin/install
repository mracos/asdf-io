#!/usr/bin/env bash

set -eu
[ "${BASH_VERSINFO[0]}" -ge 3 ] && set -o pipefail

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/cmake.bash
source "$plugin_dir/lib/cmake.bash"
# shellcheck source=lib/eerie.bash
source "$plugin_dir/lib/eerie.bash"

tmp_download_dir=$(mktemp -dt io_build_XXXXXX)
source_path="$tmp_download_dir/io-${ASDF_INSTALL_TYPE}-${ASDF_INSTALL_VERSION}"

git clone --recursive --branch "$ASDF_INSTALL_VERSION" --depth 1 https://github.com/IoLanguage/io "$source_path"

(
    cd "$source_path"

    # Only for versions before 2019.05.22-alpha, since after this version addons were
    # separated from the main repo and are now installed with eerie
    if [[ -z "${WITH_IO_ADDONS:-}" ]]; then
        sed -i.bak "s|add_subdirectory(addons)|#add_subdirectory(addons)|" CMakeLists.txt
    fi

    # Read the flags into an array line by line (bash 3.2 has no mapfile).
    CMAKE_FLAGS=()
    while IFS= read -r flag; do
        CMAKE_FLAGS+=("$flag")
    done < <(io_cmake_flags "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH" "$(/usr/bin/arch)")

    cmake "${CMAKE_FLAGS[@]}"
    make install
)

# Install the eerie package manager by default for versions that ship it.
# Opt out with WITHOUT_EERIE=1. Best-effort: never fails the Io install.
if [[ -z "${WITHOUT_EERIE:-}" ]] && io_eerie_supported "$ASDF_INSTALL_VERSION"; then
    io_install_eerie "$source_path" "$ASDF_INSTALL_PATH"
fi
